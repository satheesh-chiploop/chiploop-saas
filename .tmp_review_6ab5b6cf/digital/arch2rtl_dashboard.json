      {
        "name": "CONTROL",
        "offset": "0x00",
        "access": "RW",
        "description": "Global control register for engine enable, RX/TX path enables, internal loopback, and IRQ output enable. Unused bits read as zero and reserved bits shall be written as zero.",
        "fields": [
          {
            "name": "ENABLE",
            "lsb": 0,
            "msb": 0,
            "access": "RW",
            "reset": 0,
            "description": "Global engine enable. When 0, the engine is held in an inactive state."
          },
          {
            "name": "RX_ENABLE",
            "lsb": 1,
            "msb": 1,
            "access": "RW",
            "reset": 0,
            "description": "Enable UART receive path operation."
          },
          {
            "name": "TX_ENABLE",
            "lsb": 2,
            "msb": 2,
            "access": "RW",
            "reset": 0,
            "description": "Enable UART transmit path operation."
          },
          {
            "name": "LOOPBACK",
            "lsb": 3,
            "msb": 3,
            "access": "RW",
            "reset": 0,
            "description": "Route completed transmitted bytes into the receive acceptance path for internal smoke testing."
          },
          {
            "name": "IRQ_ENABLE",
            "lsb": 4,
            "msb": 4,
            "access": "RW",
            "reset": 0,
            "description": "Gate the irq output with the sticky IRQ_STATUS bits."
          }
        ]
      },
      {
        "name": "BAUD_DIV_LO",
        "offset": "0x04",
        "access": "RW",
        "description": "Baud-rate divider low byte used by the shared baud tick generator for RX and TX timing.",
        "fields": [
          {
            "name": "BAUD_DIV_LO",
            "lsb": 0,
            "msb": 7,
            "access": "RW",
            "reset": 0,
            "description": "BAUD_DIV[7:0]."
          }
        ]
      },
      {
        "name": "BAUD_DIV_HI",
        "offset": "0x05",
        "access": "RW",
        "description": "Baud-rate divider high byte used by the shared baud tick generator for RX and TX timing.",
        "fields": [
          {
            "name": "BAUD_DIV_HI",
            "lsb": 0,
            "msb": 7,
            "access": "RW",
            "reset": 0,
            "description": "BAUD_DIV[15:8]."
          }
        ]
      },
      {
        "name": "PACKET_LEN",
        "offset": "0x08",
        "access": "RW",
        "description": "Expected valid-byte packet length. Packet completion, rx_done, tx_done, and packet_done are qualified against this byte count.",
        "fields": [
          {
            "name": "PACKET_LEN",
            "lsb": 0,
            "msb": 7,
            "access": "RW",
            "reset": 0,
            "description": "Expected number of valid bytes in a packet."
          }
        ]
      },
      {
        "name": "TX_DATA",
        "offset": "0x0C",
        "access": "WO",
        "description": "Write-only transmit data push register. A write enqueues one byte into the 16-entry TX FIFO when not full. Writes while full latch tx_overflow and set STATUS.error.",
        "fields": [
          {
            "name": "TX_BYTE",
            "lsb": 0,
            "msb": 7,
            "access": "WO",
            "reset": 0,
            "description": "Byte to push into the TX FIFO."
          }
        ]
      },
      {
        "name": "RX_DATA",
        "offset": "0x10",
        "access": "RO",
        "description": "Read-only receive data pop register. A read dequeues one byte from the 16-entry RX FIFO when not empty. Reads while empty latch rx_underflow and set STATUS.error.",
        "fields": [
          {
            "name": "RX_BYTE",
            "lsb": 0,
            "msb": 7,
            "access": "RO",
            "reset": 0,
            "description": "Byte popped from the RX FIFO."
          }
        ]
      },
      {
        "name": "STATUS",
        "offset": "0x14",
        "access": "RO",
        "description": "Live status register reflecting FIFO occupancy and datapath activity.",
        "fields": [
          {
            "name": "tx_empty",
            "lsb": 0,
            "msb": 0,
            "access": "RO",
            "reset": 1,
            "description": "TX FIFO empty flag."
          },
          {
            "name": "tx_full",
            "lsb": 1,
            "msb": 1,
            "access": "RO",
            "reset": 0,
            "description": "TX FIFO full flag."
          },
          {
            "name": "rx_empty",
            "lsb": 2,
            "msb": 2,
            "access": "RO",
            "reset": 1,
            "description": "RX FIFO empty flag."
          },
          {
            "name": "rx_full",
            "lsb": 3,
            "msb": 3,
            "access": "RO",
            "reset": 0,
            "description": "RX FIFO full flag."
          },
          {
            "name": "tx_busy",
            "lsb": 4,
            "msb": 4,
            "access": "RO",
            "reset": 0,
            "description": "Transmit datapath busy."
          },
          {
            "name": "rx_busy",
            "lsb": 5,
            "msb": 5,
            "access": "RO",
            "reset": 0,
            "description": "Receive datapath busy."
          },
          {
            "name": "packet_active",
            "lsb": 6,
            "msb": 6,
            "access": "RO",
            "reset": 0,
            "description": "Packet transfer active indication."
          },
          {
            "name": "error",
            "lsb": 7,
            "msb": 7,
            "access": "RO",
            "reset": 0,
            "description": "Sticky/live error indication from overflow, underflow, or framing error conditions."
          }
        ]
      },
      {
        "name": "IRQ_STATUS",
        "offset": "0x18",
        "access": "RO",
        "description": "Sticky interrupt status bits that remain asserted until cleared via IRQ_CLEAR write-one-to-clear semantics.",
        "fields": [
          {
            "name": "rx_done",
            "lsb": 0,
            "msb": 0,
            "access": "RO",
            "reset": 0,
            "description": "Receive packet completion latched."
          },
          {
            "name": "tx_done",
            "lsb": 1,
            "msb": 1,
            "access": "RO",
            "reset": 0,
            "description": "Transmit packet completion latched."
          },
          {
            "name": "rx_overflow",
            "lsb": 2,
            "msb": 2,
            "access": "RO",
            "reset": 0,
            "description": "RX FIFO overflow latched."
          },
          {
            "name": "tx_underflow",
            "lsb": 3,
            "msb": 3,
            "access": "RO",
            "reset": 0,
            "description": "TX FIFO underflow latched."
          },
          {
            "name": "framing_error",
            "lsb": 4,
            "msb": 4,
            "access": "RO",
            "reset": 0,
            "description": "UART framing error latched."
          },
          {
            "name": "packet_done",
            "lsb": 5,
            "msb": 5,
            "access": "RO",
            "reset": 0,
            "description": "Packet completion latched."
          }
        ]
      },
      {
        "name": "IRQ_CLEAR",
        "offset": "0x1C",
        "access": "WO",
        "description": "Write-one-to-clear register for IRQ_STATUS bits. Bits written as 1 clear the corresponding latched IRQ_STATUS bits; bits written as 0 leave status unchanged.",
