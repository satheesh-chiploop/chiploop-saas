      "rtl_text": "module pwm_controller (\n    clk,\n    reset_n,\n    enable,\n    duty_cycle,\n    period,\n    pwm_out,\n    counter_value\n);\n\ninput clk;\ninput reset_n;\ninput enable;\ninput [7:0] duty_cycle;\ninput [7:0] period;\noutput pwm_out;\noutput [7:0] counter_value;\nreg [7:0] counter_reg;\nassign counter_value = counter_reg;\nassign pwm_out = (counter_reg < duty_cycle);\n\nalways @(posedge clk) begin\n    if (!reset_n) begin\n        counter_reg <= 8'h00;\n    end else if (enable) begin\n        if (counter_reg == period) begin\n            counter_reg <= 8'h00;\n        end else begin\n            counter_reg <= counter_reg + 8'h01;\n        end\n    end else begin\n        counter_reg <= counter_reg;\n    end\nend\n\nendmodule"
    }
