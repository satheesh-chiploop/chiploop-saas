  "software_driver_intent": {
    "init_sequence": [
      "Program TIMEOUT_CFG with a nonzero watchdog threshold.",
      "Program STALE_CFG with a nonzero freshness threshold.",
      "Program CMD_MIN and CMD_MAX to a valid clamp window.",
      "Program CMD_SAFE to the desired inhibited reference value.",
      "Program SEQ_TX and META fields with the initial control context.",
      "Clear any prior faults by writing CTRL.CLEAR_FAULT=1.",
      "Set CTRL.ENABLE=1 and CTRL.ARM_OUTPUT=1 before starting command exchange.",
      "Assert CTRL.REQUEST_START when a new request packet should be issued."
    ],
    "polling_sequence": [
      "Read STATUS for BUSY, REQ_PENDING, RSP_SEEN, STALE_FAULT, TIMEOUT_FAULT, RANGE_FAULT, FALLBACK_ACTIVE, and LAST_GOOD_VALID.",
      "Read SEQ_RX to confirm the last accepted response sequence.",
      "If a fault bit is set, service the condition in firmware and clear it with CTRL.CLEAR_FAULT=1 after remediation.",
      "Update META and SEQ_TX before the next request as required by policy."
    ],
    "irq_sequence": [
      "On FAULT_IRQ, read STATUS and SEQ_RX to determine cause and recoverability.",
      "Disable or re-arm the controller through CTRL as needed.",
      "Clear faults only after firmware has handled the condition and policy has been updated."
    ]
  },
