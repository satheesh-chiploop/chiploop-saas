      "requirement_id": "REQ-016",
      "checker_id": "a_req_016",
      "owner_module": "pwm_controller",
      "section": "reset_behavior",
      "requirement": "When reset_n is low, the counter register is synchronously cleared to 8'h00 on the next rising edge of clk, and counter_value reflects zero. pwm_out evaluates combinationally from the reset-cleared counter_value and duty_cycle, so it is high only if duty_cycle is nonzero and counter_value is less than duty_cycle; immediately after reset with counter_value at zero, pwm_out is high for any duty_cycle greater than zero and low when duty_cycle is zero.",
      "verification_method": "systemverilog_assertion",
      "requirement_classification": "systemverilog_assertion",
      "status": "generated_pending_execution",
      "cover_id": "c_req_016",
