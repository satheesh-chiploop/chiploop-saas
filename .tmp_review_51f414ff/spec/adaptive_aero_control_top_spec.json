{
  "design_name": "adaptive_aero_control_top",
  "design_summary": "Single-clock FPGA synthesizable adaptive active-aerodynamics control shell that exchanges compact 128-bit request/response packets with an external model service, exposes a small 8-bit address/32-bit data control register window, validates and de-packetizes inbound responses, enforces sequence/age/watchdog safety, clamps and rate-limits actuator recommendations, and drives only bounded scalar actuator commands with deterministic fallback behavior. The RTL does not implement the surrogate model; it only forwards requests, receives responses, and applies local safety policy before actuator drive-out.",
  "operating_constraints": {
    "clock_domains": [
      {
        "name": "clk",
        "frequency_mhz": 50.0,
        "period_ns": 20.0
      }
    ],
    "reset_signals": [
      {
        "name": "rst_n",
        "active_low": true,
        "async": false
      }
    ],
    "fixed_assumptions": [
      "All logic is single-clock and synchronous to clk.",
      "Reset is active-low and synchronously deasserted in the RTL contract.",
      "The external service is responsible only for model inference; the RTL is responsible for packet transport, validation, and local safety enforcement.",
      "The 128-bit streams carry opaque packets with fields sufficient for request/response sequencing, age, flags, handle, and compact command metadata.",
      "No large payload or tensor storage is implemented as flip-flops; any optional telemetry/history storage must be mapped to native FPGA block RAM through a technology-neutral memory wrapper if used.",
      "No surrogate prediction constants or assumed aerodynamic outputs are encoded in the RTL contract."
    ]
  },
  "implementation_requirements": [],
  "verification_requirements": [],
  "memory_macros": [
    {
      "name": "fpga_bram_history_wrapper",
      "kind": "fpga_bram",
      "depth": 64,
      "data_width": 32,
      "addr_width": 6,
      "instance_name": "u_history_bram",
      "ports": {
        "clk": "clk",
        "csb": "csb",
        "we": "we",
        "addr": "addr",
        "din": "din",
        "dout": "dout"
      },
      "requires_mbist": false
    }
  ],
