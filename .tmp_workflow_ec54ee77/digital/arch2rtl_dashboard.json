  "register_map": {
    "register_count": 4,
    "registers": [
      {
        "name": "CONTROL",
        "offset": "0x00",
        "access": "RW",
        "description": "Control register. Bit 0 enables PWM operation; all other bits are reserved and read as zero.",
        "fields": [
          {
            "name": "ENABLE",
            "lsb": 0,
            "msb": 0,
            "access": "RW",
            "reset": 0,
            "description": "When 1, the PWM counter is allowed to run if PERIOD is nonzero. When 0, the counter holds at zero and pwm_out is low."
          },
          {
            "name": "RESERVED",
            "lsb": 1,
            "msb": 7,
            "access": "RO",
            "reset": 0,
            "description": "Reserved bits. Always read as 0 and ignore writes."
          }
        ]
      },
      {
        "name": "DUTY_CYCLE",
        "offset": "0x04",
        "access": "RW",
        "description": "PWM duty-cycle compare threshold. The output is high while enabled and counter_value is less than this value.",
        "fields": [
          {
            "name": "DUTY_CYCLE",
            "lsb": 0,
            "msb": 7,
            "access": "RW",
            "reset": 0,
            "description": "8-bit duty threshold. pwm_out is high when ENABLE=1 and counter_value < DUTY_CYCLE."
          }
        ]
      },
      {
        "name": "PERIOD",
        "offset": "0x08",
        "access": "RW",
        "description": "PWM period terminal count. The counter increments while enabled and wraps to zero when it reaches this value.",
        "fields": [
          {
            "name": "PERIOD",
            "lsb": 0,
            "msb": 7,
            "access": "RW",
            "reset": 0,
            "description": "8-bit terminal count. When ENABLE=1 and PERIOD!=0, the counter increments each clock and wraps to zero upon reaching PERIOD. When PERIOD=0, the counter holds at zero and pwm_out remains low."
          }
        ]
      },
      {
        "name": "COUNTER_VALUE",
        "offset": "0x0C",
        "access": "RO",
        "description": "Live counter status register. Reflects the current internal counter value and is read-only.",
        "fields": [
          {
            "name": "COUNTER_VALUE",
            "lsb": 0,
            "msb": 7,
            "access": "RO",
            "reset": 0,
            "description": "Live 8-bit counter state. Reads return the current counter value. Writes have no effect."
          }
        ]
      }
    ]
  },
