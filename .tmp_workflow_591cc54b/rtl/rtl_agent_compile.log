      "rtl_text": "module actuator_command_fsm (\n    input clk,\n    input rst_n,\n    input frame_legal,\n    input freshness_legal,\n    input stale_fault,\n    input comm_loss_fault,\n    input internal_fault,\n    input actuator_valid_in,\n    output reg actuator_valid_out,\n    output reg [1:0] state_id,\n    output reg accepted_frame_pulse\n);\n\nlocalparam ST_SAFE = 2'b00;\nlocalparam ST_IDLE = 2'b01;\nlocalparam ST_VALID_HOLD = 2'b10;\nlocalparam ST_APPLY = 2'b11;\n\nalways @(posedge clk or negedge rst_n) begin\n    if (!rst_n) begin\n        actuator_valid_out <= 1'b0;\n        state_id <= ST_SAFE;\n        accepted_frame_pulse <= 1'b0;\n    end else begin\n        accepted_frame_pulse <= 1'b0;\n        if (stale_fault || comm_loss_fault || internal_fault) begin\n            actuator_valid_out <= 1'b0;\n            state_id <= ST_SAFE;\n        end else if (frame_legal && freshness_legal && actuator_valid_in) begin\n            actuator_valid_out <= 1'b1;\n            state_id <= ST_APPLY;\n            accepted_frame_pulse <= 1'b1;\n        end else if (frame_legal && freshness_legal) begin\n            actuator_valid_out <= 1'b0;\n            state_id <= ST_VALID_HOLD;\n        end else begin\n            actuator_valid_out <= 1'b0;\n            state_id <= ST_IDLE;\n        end\n    end\nend\n\nendmodule"
    },
