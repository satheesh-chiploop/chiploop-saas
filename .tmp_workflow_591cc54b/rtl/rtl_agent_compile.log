      "rtl_text": "module cmd_buffer (\n    input clk,\n    input rst_n,\n    input accepted_frame_pulse,\n    input [15:0] buf_seq,\n    input [11:0] buf_age,\n    input [7:0] buf_flow_mps,\n    input [15:0] buf_target,\n    input [7:0] buf_diag,\n    output reg [15:0] last_seq,\n    output reg [11:0] last_age,\n    output reg [7:0] last_flow_mps,\n    output reg [15:0] last_target,\n    output reg [7:0] last_diag\n);\n\nalways @(posedge clk or negedge rst_n) begin\n    if (!rst_n) begin\n        last_seq <= 16'h0000;\n        last_age <= 12'h000;\n        last_flow_mps <= 8'h00;\n        last_target <= 16'h0000;\n        last_diag <= 8'h00;\n    end else if (accepted_frame_pulse) begin\n        last_seq <= buf_seq;\n        last_age <= buf_age;\n        last_flow_mps <= buf_flow_mps;\n        last_target <= buf_target;\n        last_diag <= buf_diag;\n    end\nend\n\nendmodule"
