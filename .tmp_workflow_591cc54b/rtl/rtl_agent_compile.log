      "rtl_text": "module adaptive_aero_control_top (\n    input clk,\n    input rst_n,\n    input ctrl_in_valid,\n    output ctrl_in_ready,\n    input [127:0] ctrl_in_data,\n    output ctrl_out_valid,\n    input ctrl_out_ready,\n    output [127:0] ctrl_out_data,\n    input csr_valid,\n    input csr_write,\n    input [5:0] csr_addr,\n    input [31:0] csr_wdata,\n    output [31:0] csr_rdata,\n    output csr_ready\n);\nwire [7:0] rx_opcode;\nwire [15:0] rx_seq;\nwire [11:0] rx_age;\nwire [7:0] rx_flow_mps;\nwire [15:0] rx_actuator_target;\nwire [7:0] rx_diag;\nwire rx_frame_valid;\nwire opcode_legal;\nwire seq_legal;\nwire freshness_legal;\nwire flow_legal;\nwire target_legal;\nwire frame_legal;\nwire [15:0] legal_seq_next;\nwire [15:0] watchdog_count;\nwire stale_fault;\nwire comm_loss_fault;\nwire [15:0] clamped_target;\nwire target_clamp_event;\nwire actuator_safe;\nwire actuator_valid;\nwire [15:0] last_seq;\nwire [11:0] last_age;\nwire [7:0] last_flow_mps;\nwire [15:0] last_target;\nwire [7:0] last_diag;\nwire actuator_valid_out;\nwire [1:0] state_id;\nwire accepted_frame_pulse;\nwire sticky_stale_fault;\nwire sticky_invalid_frame;\nwire sticky_timeout_fault;\nwire sticky_clamp_event;\nwire sticky_comm_loss_fault;\nwire [15:0] applied_command;\nwire [15:0] last_accepted_seq;\nwire [15:0] status_watchdog_count;\nwire safe_state;\nwire [15:0] target_min;\nwire [15:0] target_max;\nwire [15:0] safe_range_min;\nwire [15:0] safe_range_max;\nwire [15:0] stale_threshold;\nwire [15:0] watchdog_preload;\nwire ctrl_in_ready_unused_from_u_stream_rx_parser_ctrl_in_ready;\nwire actuator_valid_in;\nwire [15:0] buf_seq;\nwire [15:0] buf_target;\nwire [11:0] buf_age;\nwire [7:0] buf_flow_mps;\nwire [7:0] buf_diag;\nwire internal_fault;\nstream_rx_parser u_stream_rx_parser (\n    .clk(clk),\n    .rst_n(rst_n),\n    .ctrl_in_valid(ctrl_in_valid),\n    .ctrl_in_ready(ctrl_in_ready_unused_from_u_stream_rx_parser_ctrl_in_ready),\n    .ctrl_in_data(ctrl_in_data),\n    .rx_opcode(rx_opcode),\n    .rx_seq(rx_seq),\n    .rx_age(rx_age),\n    .rx_flow_mps(rx_flow_mps),\n    .rx_actuator_target(rx_actuator_target),\n    .rx_diag(rx_diag),\n    .rx_frame_valid(rx_frame_valid)\n);\n\nrequest_validator u_request_validator (\n    .clk(clk),\n    .rst_n(rst_n),\n    .rx_opcode(rx_opcode),\n    .rx_seq(rx_seq),\n    .rx_age(rx_age),\n    .rx_flow_mps(rx_flow_mps),\n    .rx_actuator_target(rx_actuator_target),\n    .rx_frame_valid(rx_frame_valid),\n    .opcode_legal(opcode_legal),\n    .seq_legal(seq_legal),\n    .freshness_legal(freshness_legal),\n    .flow_legal(flow_legal),\n    .target_legal(target_legal),\n    .frame_legal(frame_legal),\n    .legal_seq_next(legal_seq_next)\n);\n\nwatchdog_timer u_watchdog_timer (\n    .clk(clk),\n    .rst_n(rst_n),\n    .accepted_frame_pulse(accepted_frame_pulse),\n    .watchdog_preload(watchdog_preload),\n    .stale_threshold(stale_threshold),\n    .watchdog_count(watchdog_count),\n    .stale_fault(stale_fault),\n    .comm_loss_fault(comm_loss_fault)\n);\n\nsafety_manager u_safety_manager (\n    .clk(clk),\n    .rst_n(rst_n),\n    .frame_legal(frame_legal),\n    .stale_fault(stale_fault),\n    .comm_loss_fault(comm_loss_fault),\n    .internal_fault(sticky_timeout_fault),\n    .requested_target(rx_actuator_target),\n    .target_min(target_min),\n    .target_max(target_max),\n    .safe_range_min(safe_range_min),\n    .safe_range_max(safe_range_max),\n    .clamped_target(clamped_target),\n    .target_clamp_event(target_clamp_event),\n    .actuator_safe(actuator_safe),\n    .actuator_valid(actuator_valid)\n);\n\ncmd_buffer u_cmd_buffer (\n    .clk(clk),\n    .rst_n(rst_n),\n    .accepted_frame_pulse(accepted_frame_pulse),\n    .buf_seq(legal_seq_next),\n    .buf_age(rx_age),\n    .buf_flow_mps(rx_flow_mps),\n    .buf_target(clamped_target),\n    .buf_diag(rx_diag),\n    .last_seq(last_seq),\n    .last_age(last_age),\n    .last_flow_mps(last_flow_mps),\n    .last_target(last_target),\n    .last_diag(last_diag)\n);\n\nactuator_command_fsm u_actuator_command_fsm (\n    .clk(clk),\n    .rst_n(rst_n),\n    .frame_legal(frame_legal),\n    .freshness_legal(freshness_legal),\n    .stale_fault(stale_fault),\n    .comm_loss_fault(comm_loss_fault),\n    .internal_fault(sticky_timeout_fault),\n    .actuator_valid_in(actuator_valid),\n    .actuator_valid_out(actuator_valid_out),\n    .state_id(state_id),\n    .accepted_frame_pulse(accepted_frame_pulse)\n);\n\nstatus_regs u_status_regs (\n    .clk(clk),\n    .rst_n(rst_n),\n    .csr_valid(csr_valid),\n    .csr_write(csr_write),\n    .csr_addr(csr_addr),\n    .csr_wdata(csr_wdata),\n    .csr_rdata(csr_rdata),\n    .csr_ready(csr_ready),\n    .sticky_stale_fault(sticky_stale_fault),\n    .sticky_invalid_frame(sticky_invalid_frame),\n    .sticky_timeout_fault(sticky_timeout_fault),\n    .sticky_clamp_event(sticky_clamp_event),\n    .sticky_comm_loss_fault(sticky_comm_loss_fault),\n    .applied_command(applied_command),\n    .last_accepted_seq(last_accepted_seq),\n    .watchdog_count(status_watchdog_count),\n    .safe_state(safe_state),\n    .target_min(target_min),\n    .target_max(target_max),\n    .safe_range_min(safe_range_min),\n    .safe_range_max(safe_range_max),\n    .stale_threshold(stale_threshold),\n    .watchdog_preload(watchdog_preload)\n);\n\nassign ctrl_out_valid = accepted_frame_pulse | sticky_stale_fault | sticky_invalid_frame | sticky_timeout_fault | sticky_clamp_event | sticky_comm_loss_fault;\nassign ctrl_out_data = {36'b0, accepted_frame_pulse, frame_legal, freshness_legal, stale_fault, comm_loss_fault, actuator_valid_out, state_id, last_seq, last_age, last_flow_mps, last_target, last_diag, clamped_target, 8'h00};\nassign ctrl_in_ready = 1'b1;\n\nendmodule"
