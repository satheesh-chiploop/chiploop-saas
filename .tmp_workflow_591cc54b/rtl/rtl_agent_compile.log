      "rtl_text": "module stream_rx_parser (\n    input clk,\n    input rst_n,\n    input ctrl_in_valid,\n    output reg ctrl_in_ready,\n    input [127:0] ctrl_in_data,\n    output reg [7:0] rx_opcode,\n    output reg [15:0] rx_seq,\n    output reg [11:0] rx_age,\n    output reg [7:0] rx_flow_mps,\n    output reg [15:0] rx_actuator_target,\n    output reg [7:0] rx_diag,\n    output reg rx_frame_valid\n);\n\nalways @(posedge clk or negedge rst_n) begin\n    if (!rst_n) begin\n        ctrl_in_ready <= 1'b1;\n        rx_opcode <= 8'h00;\n        rx_seq <= 16'h0000;\n        rx_age <= 12'h000;\n        rx_flow_mps <= 8'h00;\n        rx_actuator_target <= 16'h0000;\n        rx_diag <= 8'h00;\n        rx_frame_valid <= 1'b0;\n    end else begin\n        ctrl_in_ready <= 1'b1;\n        if (ctrl_in_valid && ctrl_in_ready) begin\n            rx_opcode <= ctrl_in_data[127:120];\n            rx_seq <= ctrl_in_data[119:104];\n            rx_age <= ctrl_in_data[103:92];\n            rx_flow_mps <= ctrl_in_data[91:84];\n            rx_actuator_target <= ctrl_in_data[83:68];\n            rx_diag <= ctrl_in_data[67:60];\n            rx_frame_valid <= (ctrl_in_data[127:120] == 8'hA5) || (ctrl_in_data == 128'h0);\n        end else begin\n            rx_frame_valid <= 1'b0;\n        end\n    end\nend\n\nendmodule"
