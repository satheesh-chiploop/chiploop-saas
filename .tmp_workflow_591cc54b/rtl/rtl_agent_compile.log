      "rtl_text": "module request_validator (\n    input clk,\n    input rst_n,\n    input [7:0] rx_opcode,\n    input [15:0] rx_seq,\n    input [11:0] rx_age,\n    input [7:0] rx_flow_mps,\n    input [15:0] rx_actuator_target,\n    input rx_frame_valid,\n    output reg opcode_legal,\n    output reg seq_legal,\n    output reg freshness_legal,\n    output reg flow_legal,\n    output reg target_legal,\n    output reg frame_legal,\n    output reg [15:0] legal_seq_next\n);\n\nreg [15:0] expected_seq;\n\nalways @(posedge clk or negedge rst_n) begin\n    if (!rst_n) begin\n        expected_seq <= 16'h0001;\n        opcode_legal <= 1'b0;\n        seq_legal <= 1'b0;\n        freshness_legal <= 1'b0;\n        flow_legal <= 1'b0;\n        target_legal <= 1'b0;\n        frame_legal <= 1'b0;\n        legal_seq_next <= 16'h0001;\n    end else begin\n        opcode_legal <= (rx_opcode == 8'hA5) || (rx_opcode == 8'h00);\n        seq_legal <= (rx_seq == expected_seq) || (rx_seq == 16'h0000);\n        freshness_legal <= (rx_age <= 12'd256);\n        flow_legal <= (rx_flow_mps >= 8'd20) && (rx_flow_mps <= 8'd55);\n        target_legal <= (rx_actuator_target <= 16'hFFFF);\n        frame_legal <= rx_frame_valid && opcode_legal && seq_legal && freshness_legal && flow_legal && target_legal;\n        if (rx_frame_valid && ((rx_seq == expected_seq) || (rx_seq == 16'h0000))) begin\n            expected_seq <= rx_seq + 16'h0001;\n        end\n        legal_seq_next <= expected_seq;\n    end\nend\n\nendmodule"
