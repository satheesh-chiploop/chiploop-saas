      "rtl_text": "module status_regs (\n    input clk,\n    input rst_n,\n    input csr_valid,\n    input csr_write,\n    input [5:0] csr_addr,\n    input [31:0] csr_wdata,\n    output reg [31:0] csr_rdata,\n    output reg csr_ready,\n    output reg sticky_stale_fault,\n    output reg sticky_invalid_frame,\n    output reg sticky_timeout_fault,\n    output reg sticky_clamp_event,\n    output reg sticky_comm_loss_fault,\n    output reg [15:0] applied_command,\n    output reg [15:0] last_accepted_seq,\n    output reg [15:0] watchdog_count,\n    output reg safe_state,\n    output reg [15:0] target_min,\n    output reg [15:0] target_max,\n    output reg [15:0] safe_range_min,\n    output reg [15:0] safe_range_max,\n    output reg [15:0] stale_threshold,\n    output reg [15:0] watchdog_preload\n);\n\nalways @(posedge clk or negedge rst_n) begin\n    if (!rst_n) begin\n        csr_rdata <= 32'h00000000;\n        csr_ready <= 1'b0;\n        sticky_stale_fault <= 1'b0;\n        sticky_invalid_frame <= 1'b0;\n        sticky_timeout_fault <= 1'b0;\n        sticky_clamp_event <= 1'b0;\n        sticky_comm_loss_fault <= 1'b0;\n        applied_command <= 16'h0000;\n        last_accepted_seq <= 16'h0000;\n        watchdog_count <= 16'h0000;\n        safe_state <= 1'b1;\n        target_min <= 16'h0000;\n        target_max <= 16'hFFFF;\n        safe_range_min <= 16'h0000;\n        safe_range_max <= 16'hFFFF;\n        stale_threshold <= 16'h0100;\n        watchdog_preload <= 16'h0000;\n    end else begin\n        csr_ready <= csr_valid;\n        if (csr_valid && csr_write) begin\n            case (csr_addr)\n                6'd0: begin\n                    if (csr_wdata[0]) safe_state <= 1'b0;\n                    if (csr_wdata[1]) begin\n                        sticky_stale_fault <= 1'b0;\n                        sticky_invalid_frame <= 1'b0;\n                        sticky_timeout_fault <= 1'b0;\n                        sticky_clamp_event <= 1'b0;\n                        sticky_comm_loss_fault <= 1'b0;\n                    end\n                end\n                6'd8: target_min <= csr_wdata[15:0];\n                6'd9: target_max <= csr_wdata[15:0];\n                6'd10: safe_range_min <= csr_wdata[15:0];\n                6'd11: safe_range_max <= csr_wdata[15:0];\n                6'd12: stale_threshold <= csr_wdata[15:0];\n                6'd13: watchdog_preload <= csr_wdata[15:0];\n                default: begin end\n            endcase\n        end\n        case (csr_addr)\n            6'd0: csr_rdata <= {30'h00000000, 1'b0, 1'b0};\n            6'd1: csr_rdata <= {26'h0000000, safe_state, sticky_comm_loss_fault, sticky_clamp_event, sticky_timeout_fault, sticky_invalid_frame, sticky_stale_fault};\n            6'd2: csr_rdata <= {16'h0000, applied_command};\n            6'd3: csr_rdata <= {16'h0000, last_accepted_seq};\n            6'd4: csr_rdata <= {16'h0000, watchdog_count};\n            6'd8: csr_rdata <= {16'h0000, target_min};\n            6'd9: csr_rdata <= {16'h0000, target_max};\n            6'd10: csr_rdata <= {16'h0000, safe_range_min};\n            6'd11: csr_rdata <= {16'h0000, safe_range_max};\n            6'd12: csr_rdata <= {16'h0000, stale_threshold};\n            6'd13: csr_rdata <= {16'h0000, watchdog_preload};\n            default: csr_rdata <= 32'h00000000;\n        endcase\n    end\nend\n\nendmodule"
