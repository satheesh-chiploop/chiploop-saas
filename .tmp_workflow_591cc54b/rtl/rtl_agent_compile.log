      "rtl_text": "module safety_manager (\n    input clk,\n    input rst_n,\n    input frame_legal,\n    input stale_fault,\n    input comm_loss_fault,\n    input internal_fault,\n    input [15:0] requested_target,\n    input [15:0] target_min,\n    input [15:0] target_max,\n    input [15:0] safe_range_min,\n    input [15:0] safe_range_max,\n    output reg [15:0] clamped_target,\n    output reg target_clamp_event,\n    output reg actuator_safe,\n    output reg actuator_valid\n);\n\nreg target_low_clamp;\nreg target_high_clamp;\nreg safe_in_range;\n\nalways @(posedge clk or negedge rst_n) begin\n    if (!rst_n) begin\n        clamped_target <= 16'h0000;\n        target_clamp_event <= 1'b0;\n        actuator_safe <= 1'b1;\n        actuator_valid <= 1'b0;\n    end else begin\n        target_low_clamp <= (requested_target < target_min);\n        target_high_clamp <= (requested_target > target_max);\n        if (requested_target < target_min)\n            clamped_target <= target_min;\n        else if (requested_target > target_max)\n            clamped_target <= target_max;\n        else\n            clamped_target <= requested_target;\n\n        target_clamp_event <= (requested_target < target_min) || (requested_target > target_max);\n        safe_in_range <= (clamped_target >= safe_range_min) && (clamped_target <= safe_range_max);\n        actuator_valid <= frame_legal && !stale_fault && !comm_loss_fault && !internal_fault;\n        actuator_safe <= (!actuator_valid) || safe_in_range || stale_fault || comm_loss_fault || internal_fault;\n    end\nend\n\nendmodule"
