      "feature_id": "reset_clears_outputs",
      "statement": "Asserting reset_n low clears the registered counter state, which forces counter_value to zero and pwm_out low on the next observable cycle.",
      "stimulus": {
        "reset_n": 0,
        "enable": 1,
        "duty_cycle": 128,
        "period": 10
      },
      "stimulus_steps": [
        {
          "signals": {
            "reset_n": 0,
            "enable": 1,
            "duty_cycle": 128,
            "period": 10
          },
          "cycles": 1
        }
      ],
      "expected": {
        "counter_value": {
          "eq": 0
        },
        "pwm_out": {
          "eq": 0
        }
      },
      "wait_cycles": 1,
      "monitors": [
        "counter_value",
        "pwm_out",
        "reset_n"
      ],
      "registers": [],
