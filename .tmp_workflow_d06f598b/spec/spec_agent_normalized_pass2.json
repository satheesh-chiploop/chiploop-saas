  "hierarchy": {
    "top_module": {
      "name": "adaptive_aero_control_top",
      "description": "Top-level adaptive aero controller that integrates firmware MMIO, model transport, validation/safety logic, command generation, and bulk history storage without flattening memory into registers.",
      "ports": [
        {
          "name": "clk",
          "direction": "input",
          "width": 1
        },
        {
          "name": "reset_n",
          "direction": "input",
          "width": 1,
          "active_low": true
        },
        {
