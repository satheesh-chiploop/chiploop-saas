        "functionality": "Decodes the firmware-visible MMIO interface into writable configuration and readable status registers. Exposes semantic control fields for enable, target speed, command slew bound, timeout, and fault clear, and returns controller status and fault state through readback.",
        "responsibilities": [
          "Decode writes into final semantic configuration fields.",
          "Return read data for implemented registers and fields.",
          "Provide software-visible control of enable, target speed, command limits, timeout, and fault clear.",
          "Expose status and latched fault state for firmware.",
          "Keep inaccessible internal state out of the software contract."
        ],
        "must_drive": [
          "mmio_ready",
          "mmio_rdata",
          "mmio_rvalid",
          "cfg_enable",
          "cfg_target_speed_mps",
          "cfg_max_cmd_delta",
          "cfg_timeout_cycles",
          "cfg_fault_clear"
        ],
