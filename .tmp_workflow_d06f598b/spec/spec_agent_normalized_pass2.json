  "feature_contracts": [
    {
      "id": "feature_1_dc8a439a",
      "description": "MMIO write to CTRL enables the controller and exposes the semantic enable field to the control core.",
      "stimulus": {
        "steps": [
          {
            "signals": {
              "mmio_addr": 0,
              "mmio_wdata": 1,
              "mmio_valid": 1,
              "mmio_write": 1
            },
            "cycles": 1
          }
        ]
      },
      "expected": {
        "mmio_ready": {
          "eq": 1
        },
        "cfg_enable": {
          "eq": 1
        }
      },
      "within_cycles": 1
    },
    {
      "id": "feature_2_abf85630",
      "description": "MMIO write to TARGET_SPEED_MPS updates the firmware-visible target speed semantic field.",
      "stimulus": {
        "steps": [
          {
            "signals": {
              "mmio_addr": 4,
              "mmio_wdata": 27,
              "mmio_valid": 1,
              "mmio_write": 1
            },
            "cycles": 1
          }
        ]
      },
      "expected": {
        "mmio_ready": {
          "eq": 1
        },
        "cfg_target_speed_mps": {
          "eq": 27
        }
      },
      "within_cycles": 1
    },
    {
      "id": "feature_3_7d900f1d",
      "description": "MMIO write to TIMEOUT_CYCLES updates the controller timeout semantic field.",
      "stimulus": {
        "steps": [
          {
            "signals": {
              "mmio_addr": 12,
              "mmio_wdata": 100,
              "mmio_valid": 1,
              "mmio_write": 1
            },
            "cycles": 1
          }
        ]
      },
      "expected": {
        "mmio_ready": {
          "eq": 1
        },
        "cfg_timeout_cycles": {
          "eq": 100
        }
      },
      "within_cycles": 1
    },
    {
      "id": "feature_4_e96dc3c2",
      "description": "A valid model request is issued by the controller through the external transport with the required output direction.",
      "stimulus": {
        "steps": [
          {
            "signals": {
              "mmio_addr": 0,
              "mmio_wdata": 1,
              "mmio_write": 1,
              "mmio_valid": 1
            },
            "cycles": 1
          },
          {
            "signals": {
              "model_req_ready": 1,
              "mmio_write": 0,
              "mmio_valid": 0
            },
            "cycles": 1
          }
        ]
      },
      "expected": {
        "model_req_valid": {
          "eq": 1
        },
        "req_valid": {
          "eq": 1
        }
      },
      "within_cycles": 1
    }
  ],
