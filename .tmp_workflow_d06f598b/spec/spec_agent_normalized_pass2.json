          "mmio_valid",
          "mmio_write",
          "status_word",
          "fault_latched"
        ],
        "must_not_drive": [
          "status_word",
          "fault_latched"
        ],
        "reset_behavior": "Returns MMIO handshake outputs to inactive states and clears writable configuration fields to safe inhibited defaults.",
        "behavior_rules": [
          "Each semantic configuration field must be fully decoded from MMIO writes and be visible as a real output port.",
          "MMIO reads must return the implemented status and configuration values only for defined registers.",
          "Fault clear is a one-cycle control pulse or equivalent write-side semantic field; it must not directly invent a fallback command.",
          "This module must not consume raw transport buses in place of semantic control fields."
        ],
        "rtl_output_file": "adaptive_aero_register_map.v"
      },
      {
