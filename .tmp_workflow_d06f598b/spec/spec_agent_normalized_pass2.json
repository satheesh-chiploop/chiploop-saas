        "functionality": "Manages the external model transport handshake and buffers request/response activity for the controller. It presents request valid/data as outputs and response ready as an output, while receiving request ready and response valid/data as inputs, matching the mandatory direction contract.",
        "responsibilities": [
          "Drive model-request valid/data outputs.",
          "Receive model-request ready as an input.",
          "Receive model-response valid/data as inputs.",
          "Drive model-response ready as an output.",
          "Bridge the controller's semantic request/response flow to the external transport contract.",
          "Maintain handshake correctness without substituting a fallback response path."
        ],
        "must_drive": [
          "req_valid",
          "req_data",
          "rsp_ready",
          "model_out_valid",
          "model_out_data"
        ],
        "must_receive": [
          "clk",
          "reset_n",
