        },
        {
          "name": "mmio_rvalid",
          "direction": "output",
          "width": 1
        },
        {
          "name": "req_valid",
          "direction": "output",
          "width": 1
        },
        {
          "name": "req_data",
          "direction": "output",
          "width": 32
        },
        {
          "name": "req_ready",
          "direction": "input",
          "width": 1
        },
        {
          "name": "rsp_valid",
          "direction": "input",
          "width": 1
        },
        {
          "name": "rsp_data",
          "direction": "input",
          "width": 32
        },
        {
          "name": "rsp_ready",
          "direction": "output",
          "width": 1
        },
        {
          "name": "actuator_cmd_valid",
          "direction": "output",
          "width": 1
        },
        {
          "name": "actuator_cmd_data",
          "direction": "output",
          "width": 16
        },
        {
          "name": "fault_latched",
          "direction": "output",
          "width": 1
        },
        {
          "name": "status_valid",
          "direction": "output",
          "width": 1
        },
        {
          "name": "status_data",
          "direction": "output",
          "width": 32
        }
      ],
      "functionality": "Implements the complete adaptive aero control top-level contract: accepts firmware CSR/MMIO transactions, exposes status and configuration registers, generates external physics-model requests, consumes model responses, validates inputs and timing, produces bounded actuator commands for 20\u201355 m/s operation, latches fault conditions for software handling, and records bulk history in technology-neutral SRAM-mapped storage.",
      "responsibilities": [
        "Provide the synthesizable top-level integration point requested by firmware and hardware.",
        "Decode MMIO writes and reads into implemented control/status registers.",
        "Emit model-request valid/data and accept model-request ready according to the mandatory transport direction contract.",
        "Accept model-response valid/data and emit model-response ready according to the mandatory transport direction contract.",
        "Generate bounded actuator commands only when inputs are valid and fresh.",
        "Deassert actuator command validity on invalid, stale, timeout, reset, or fault conditions.",
        "Latch faults for software visibility instead of silently substituting fallback commands.",
        "Instantiate and use the declared SRAM macro for history/payload storage."
      ],
      "must_drive": [
        "mmio_ready",
        "mmio_rdata",
        "mmio_rvalid",
        "req_valid",
        "req_data",
        "rsp_ready",
        "actuator_cmd_valid",
        "actuator_cmd_data",
        "fault_latched",
        "status_valid",
        "status_data"
      ],
      "must_receive": [
        "clk",
        "reset_n",
        "mmio_addr",
        "mmio_wdata",
        "mmio_valid",
        "mmio_write",
        "req_ready",
        "rsp_valid",
        "rsp_data"
      ],
      "must_not_drive": [
        "req_ready",
        "rsp_valid",
        "rsp_data"
      ],
      "reset_behavior": "On reset, the top deasserts mmio_ready, mmio_rvalid, req_valid, rsp_ready, actuator_cmd_valid, and status_valid; clears or initializes output data buses to benign values; and clears the latched fault and control state to a safe inhibited baseline without asserting any fallback command.",
      "behavior_rules": [
        "All MMIO/register-visible configuration and status must be reachable through the declared MMIO bus.",
        "The top must not expose inaccessible internal state as software-visible registers.",
        "The top must not flatten bulk history storage into discrete registers; it must use the declared SRAM macro.",
        "Model-request and model-response directionality must follow the mandatory transport contract regardless of naming.",
        "If input validity, response freshness, timeout, range checks, or fault checks fail, actuator_cmd_valid must deassert and fault_latched must assert or remain asserted.",
        "Actuator command data must remain bounded for the intended operating range and must not be replaced with a fallback command on fault.",
        "Firmware-visible status shall be provided through status_valid/status_data and MMIO readback."
      ],
      "rtl_output_file": "adaptive_aero_control_top.v"
    },
    "modules": [
