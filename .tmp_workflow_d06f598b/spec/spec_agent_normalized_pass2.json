          "rsp_valid",
          "rsp_data",
          "model_in_valid",
          "model_in_data",
          "model_out_ready"
        ],
        "must_not_drive": [
          "req_ready",
          "rsp_valid",
          "rsp_data",
          "model_in_valid",
          "model_in_data",
          "model_out_ready"
        ],
        "reset_behavior": "Deasserts both request and response transport activity and clears buffered transport state to idle.",
        "behavior_rules": [
          "The module must not reverse the mandated transport direction.",
          "The top-level request output must have a real RTL driver.",
          "The top-level response-ready output must be actively driven by RTL.",
          "Transport signals must remain distinct from firmware MMIO signals."
        ],
        "rtl_output_file": "adaptive_aero_model_transport.v"
