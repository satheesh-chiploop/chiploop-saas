{
  "design_name": "adaptive_aero_control_top",
  "design_summary": "Synthesizable single-clock FPGA control-and-safety top for automotive aerodynamics host-managed surrogate execution. Implements firmware-visible CSR/MMIO control and status, compact 128-bit host request/response transport, validation, sequence tracking, watchdog timeout handling, safety gating, and registered actuator command outputs without instantiating the surrogate model in RTL.",
  "operating_constraints": {
    "clock_domains": [
      {
        "name": "clk",
        "frequency_mhz": 50.0,
        "period_ns": 20.0
      }
    ],
    "reset_signals": [
      {
        "name": "rst_n",
        "active_low": true,
        "async": false
      }
    ],
    "fixed_assumptions": [
      "Single synchronous clock domain only.",
      "Top-level ports are limited to clk and rst_n plus the required streaming, CSR/MMIO, and actuator command interfaces.",
      "No vehicle geometry arrays, flow fields, pressure maps, or model tensors are exposed as top-level ports.",
      "No external surrogate model is instantiated in RTL; the top only implements transport, validation, timeout, status, and command gating.",
      "No fallback command is silently substituted on invalid, stale, timeout, reset, or fault conditions; actuator command validity is deasserted and faults are latched for software handling.",
      "Any bulk payload/history buffering beyond scalar state shall be technology-neutral and BRAM-mappable if required."
    ]
  },
  "implementation_requirements": [],
  "verification_requirements": [],
  "feature_contracts": [
    {
      "id": "reset_safe_baseline",
      "description": "After reset, externally visible command validity is deasserted, safe-state indication is asserted, and faults are cleared or in their reset-defined state until a valid request is accepted.",
      "stimulus": {
        "steps": [
          {
            "signals": {
              "rst_n": 0
            },
            "cycles": 1
          }
        ]
      },
      "expected": {
        "actuator_cmd_valid": 0,
        "actuator_cmd_safe": 1,
        "actuator_cmd_fault": 0
      },
      "within_cycles": 1
    },
    {
      "id": "csr_write_and_readback",
      "description": "A firmware CSR write updates the register block and produces ready/acknowledge semantics, with readable status/configuration reflected on csr_rdata.",
      "stimulus": {
        "steps": [
          {
            "signals": {
              "rst_n": 1,
              "csr_valid": 1,
              "csr_write": 1,
              "csr_addr": 0,
              "csr_wdata": 1
            },
            "cycles": 1
          }
        ]
      },
      "expected": {
        "csr_ready": 1
      },
      "within_cycles": 2
    },
    {
      "id": "request_handshake_valid_accept",
      "description": "A valid host request can be accepted when ready, allowing the transport engine to drive a registered response and command path behavior according to configuration.",
      "stimulus": {
        "steps": [
          {
            "signals": {
              "rst_n": 1,
              "req_valid": 1,
              "rsp_ready": 1,
              "req_data": 0
            },
            "cycles": 1
          }
        ]
      },
      "expected": {
        "req_ready": 1,
        "rsp_valid": 1,
        "rsp_data": 0
      },
      "within_cycles": 2
    },
    {
      "id": "timeout_fault_inhibits_command",
      "description": "When the watchdog expires, command validity is suppressed and safe-state indication is asserted for software handling.",
      "stimulus": {
        "steps": [
          {
            "signals": {
              "rst_n": 1,
              "req_valid": 1,
              "rsp_ready": 1,
              "req_data": 0
            },
            "cycles": 1
          },
          {
            "signals": {
              "req_valid": 0,
              "rsp_ready": 1
            },
            "cycles": 1
          }
        ]
      },
      "expected": {
        "actuator_cmd_valid": 0,
        "actuator_cmd_safe": 1
      },
      "within_cycles": 2
    },
    {
      "id": "stale_request_rejected",
      "description": "A stale request is rejected rather than accepted into the command path.",
      "stimulus": {
        "steps": [
          {
            "signals": {
              "rst_n": 1,
              "req_valid": 1,
              "req_data": 0
            },
            "cycles": 1
          }
        ]
      },
      "expected": {
        "actuator_cmd_valid": 0
      },
      "within_cycles": 1
    },
    {
      "id": "clamp_within_bounds",
      "description": "When a valid command exceeds configured bounds, the transport path clamps it to the programmed minimum or maximum before forwarding and flags the clamp event.",
      "stimulus": {
        "steps": [
          {
            "signals": {
              "rst_n": 1,
              "req_valid": 1,
              "rsp_ready": 1,
              "req_data": 0
            },
            "cycles": 1
          }
        ]
      },
      "expected": {
        "actuator_cmd_valid": 1,
        "actuator_cmd_value": 32767
      },
      "within_cycles": 2
    }
  ],
  "memory_macros": [
    {
      "name": "fpga_bram_generic",
      "kind": "fpga_bram",
      "depth": 64,
      "data_width": 128,
      "addr_width": 6,
      "instance_name": "u_payload_buf",
      "ports": {
        "clk": "clk",
        "csb": "payload_mem_csb",
        "we": "payload_mem_we",
        "addr": "payload_mem_addr",
        "din": "payload_mem_din",
        "dout": "payload_mem_dout"
      },
      "requires_mbist": false,
      "technology_binding": "technology_neutral_inferred_memory"
    }
  ],
  "hierarchy": {
    "top_module": {
      "name": "adaptive_aero_control_top",
      "description": "Top-level FPGA control-and-safety block for host-managed aerodynamic surrogate operation. It exposes the firmware-visible CSR/MMIO interface, the 128-bit request/response transport, and the registered actuator command outputs. It performs protocol decode, opcode validation, sequence checking, freshness checking, watchdog management, fault latching, and command gating, while keeping state minimal and deterministic.",
