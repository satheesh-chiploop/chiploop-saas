    - wr_data[5] ( PIN wr_data[5] ) + USE SIGNAL ;
    - wr_data[6] ( PIN wr_data[6] ) + USE SIGNAL ;
    - wr_data[7] ( PIN wr_data[7] ) + USE SIGNAL ;
    - wr_data[8] ( PIN wr_data[8] ) + USE SIGNAL ;
    - wr_data[9] ( PIN wr_data[9] ) + USE SIGNAL ;
    - wr_en ( PIN wr_en ) + USE SIGNAL ;
END NETS
END DESIGN
