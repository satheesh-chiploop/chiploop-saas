  "software_driver_intent": {
    "init_sequence": [
      "Hold reset_n low, then release synchronous reset.",
      "Program TIMEOUT_LIMIT and STALE_LIMIT to supervisory policy values.",
      "Program ACTUATOR_MIN and ACTUATOR_MAX to the desired clamp window.",
      "Write CONTROL.REQUEST_SEQ_SEED with the initial sequence token seed.",
      "Set CONTROL.CLEAR_FAULT with a write-one pulse if a previous fault must be cleared.",
      "Set CONTROL.MODE as required by the operating policy.",
      "Set CONTROL.ENABLE to 1 to allow request issuance and accepted command generation."
    ],
    "polling_sequence": [
      "Poll STATUS.READY and STATUS.FAULT_PRESENT.",
      "Poll STATUS.SAFE_FALLBACK_ACTIVE and STATUS.TIMEOUT_ACTIVE during operation.",
      "Read STATUS.LAST_SEQ after accepted response transactions.",
      "Read LAST_COMMAND to observe the last clamped actuator command.",
      "Read FAULT_CODE_DIAG to diagnose timeout, malformed packet, stale data, or sequence mismatch events."
    ],
