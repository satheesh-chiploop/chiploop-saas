      "rtl_text": "module adaptive_aero_buffer_controller (\n    input  clk,\n    input  reset_n,\n    input  buf_en,\n    input  buf_we,\n    input  [7:0] buf_addr,\n    input  [63:0] buf_din,\n    output [63:0] buf_dout,\n    output sram_csb,\n    output sram_we,\n    output [5:0] sram_addr,\n    output [63:0] sram_din,\n    input  [63:0] sram_dout\n);\n    reg [63:0] buf_dout_r;\n    reg sram_csb_r;\n    reg sram_we_r;\n    reg [5:0] sram_addr_r;\n    reg [63:0] sram_din_r;\n    assign buf_dout = buf_dout_r;\n    assign sram_csb = sram_csb_r;\n    assign sram_we = sram_we_r;\n    assign sram_addr = sram_addr_r;\n    assign sram_din = sram_din_r;\n\n    always @(posedge clk or negedge reset_n) begin\n        if (!reset_n) begin\n            buf_dout_r <= 64'h0000000000000000;\n            sram_csb_r <= 1'b1;\n            sram_we_r <= 1'b0;\n            sram_addr_r <= 6'h00;\n            sram_din_r <= 64'h0000000000000000;\n        end else begin\n            sram_csb_r <= ~buf_en;\n            sram_we_r <= buf_en & buf_we;\n            sram_addr_r <= buf_addr[5:0];\n            sram_din_r <= buf_din;\n            if (buf_en) buf_dout_r <= sram_dout;\n        end\n    end\nendmodule"
