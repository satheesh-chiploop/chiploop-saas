      "rtl_text": "module adaptive_aero_control_top (\n    input  clk,\n    input  reset_n,\n    input  [7:0] csr_addr,\n    input  [63:0] csr_wdata,\n    input  csr_we,\n    input  csr_re,\n    input  csr_valid,\n    output csr_ready,\n    output [63:0] csr_rdata,\n    output stream_out_valid,\n    input  stream_out_ready,\n    output [63:0] stream_out_data,\n    input  stream_in_valid,\n    output stream_in_ready,\n    input  [63:0] stream_in_data,\n    output [31:0] actuator_cmd,\n    output actuator_cmd_valid,\n    output [7:0] fault_code,\n    input  [63:0] buf_dout\n);\nwire cfg_enable;\nwire [1:0] cfg_mode;\nwire cfg_clear_fault;\nwire [15:0] cfg_request_seq_seed;\nwire [15:0] cfg_timeout_limit;\nwire [15:0] cfg_stale_limit;\nwire [31:0] cfg_actuator_min;\nwire [31:0] cfg_actuator_max;\nwire [7:0] cfg_request_seq_current;\nwire status_ready;\nwire status_fault_present;\nwire [15:0] status_last_seq;\nwire status_timeout_active;\nwire [31:0] status_last_command;\nwire [7:0] status_fault_code;\nwire [7:0] status_diag_flags;\nwire fault_clear_ack;\nwire req_valid;\n    wire req_ready;\nwire [63:0] req_data;\nwire rsp_ready;\n    wire fault_present;\nwire [7:0] ts_fault_code;\nwire ts_status_ready;\nwire ts_status_timeout_active;\nwire [15:0] ts_status_last_seq;\nwire [31:0] ts_status_last_command;\nwire [7:0] ts_status_diag_flags;\nwire [31:0] ts_actuator_cmd;\nwire ts_actuator_cmd_valid;\nwire ts_fault_clear_ack;\n    wire buf_en;\nwire buf_we;\n    wire [7:0] buf_addr;\nwire [63:0] buf_din;\nwire sram_csb;\nwire sram_we;\nwire [5:0] sram_addr;\nwire [63:0] sram_din;\n    wire [63:0] sram_dout_observed;\nwire [63:0] sram_dout;\nwire [63:0] buf_dout_observe;\n    assign stream_out_valid = req_valid;\n    assign stream_out_data = req_data;\n    assign stream_in_ready = rsp_ready;\n    assign actuator_cmd = ts_actuator_cmd;\n    assign actuator_cmd_valid = ts_actuator_cmd_valid;\n    assign fault_code = ts_fault_code;\n    assign fault_present = 1'b0;\n    assign status_ready = ts_status_ready;\n    assign status_fault_present = fault_present;\n    assign status_last_seq = ts_status_last_seq;\n    assign status_timeout_active = ts_status_timeout_active;\n    assign status_last_command = ts_status_last_command;\n    assign status_fault_code = ts_fault_code;\n    assign status_diag_flags = ts_status_diag_flags;\n    assign fault_clear_ack = ts_fault_clear_ack;\n\n    assign buf_en = status_ready;\n    assign buf_we = csr_ready;\n    assign buf_addr = cfg_request_seq_current;\n    assign buf_din = req_data;\n    assign sram_dout_observed = buf_dout;\n\n    adaptive_aero_csr_mmio u_csr_mmio (\n        .clk(clk),\n        .reset_n(reset_n),\n        .csr_addr(csr_addr),\n        .csr_wdata(csr_wdata),\n        .csr_we(csr_we),\n        .csr_re(csr_re),\n        .csr_valid(csr_valid),\n        .csr_ready(csr_ready),\n        .csr_rdata(csr_rdata),\n        .cfg_enable(cfg_enable),\n        .cfg_mode(cfg_mode),\n        .cfg_clear_fault(cfg_clear_fault),\n        .cfg_request_seq_seed(cfg_request_seq_seed),\n        .cfg_timeout_limit(cfg_timeout_limit),\n        .cfg_stale_limit(cfg_stale_limit),\n        .cfg_actuator_min(cfg_actuator_min),\n        .cfg_actuator_max(cfg_actuator_max),\n        .cfg_request_seq_current(cfg_request_seq_current),\n        .status_ready(status_ready),\n        .status_fault_present(status_fault_present),\n        .status_last_seq(status_last_seq),\n        .status_timeout_active(status_timeout_active),\n        .status_last_command(status_last_command),\n        .status_fault_code(status_fault_code),\n        .status_diag_flags(status_diag_flags),\n        .fault_clear_ack(fault_clear_ack)\n    );\n\n    adaptive_aero_transport_supervisor u_transport_supervisor (\n        .clk(clk),\n        .reset_n(reset_n),\n        .cfg_enable(cfg_enable),\n        .cfg_mode(cfg_mode),\n        .cfg_clear_fault(cfg_clear_fault),\n        .cfg_request_seq_seed(cfg_request_seq_seed),\n        .cfg_timeout_limit(cfg_timeout_limit),\n        .cfg_stale_limit(cfg_stale_limit),\n        .cfg_actuator_min(cfg_actuator_min),\n        .cfg_actuator_max(cfg_actuator_max),\n        .cfg_request_seq_current(cfg_request_seq_current),\n        .req_valid(req_valid),\n        .req_ready(stream_out_ready),\n        .req_data(req_data),\n        .rsp_valid(stream_in_valid),\n        .rsp_ready(rsp_ready),\n        .rsp_data(stream_in_data),\n        .fault_present(),\n        .fault_code(ts_fault_code),\n        .status_ready(ts_status_ready),\n        .status_timeout_active(ts_status_timeout_active),\n        .status_last_seq(ts_status_last_seq),\n        .status_last_command(ts_status_last_command),\n        .status_diag_flags(ts_status_diag_flags),\n        .actuator_cmd(ts_actuator_cmd),\n        .actuator_cmd_valid(ts_actuator_cmd_valid),\n        .fault_clear_ack(ts_fault_clear_ack)\n    );\n\n    adaptive_aero_buffer_controller u_buffer_controller (\n        .clk(clk),\n        .reset_n(reset_n),\n        .buf_en(buf_en),\n        .buf_we(buf_we),\n        .buf_addr(buf_addr),\n        .buf_din(buf_din),\n        .buf_dout(),\n        .sram_csb(sram_csb),\n        .sram_we(sram_we),\n        .sram_addr(sram_addr),\n        .sram_din(sram_din),\n        .sram_dout(sram_dout_observed)\n    );\n\n    generic_fpgabrams_64x64 u_generic_fpgabrams_64x64 (\n        .clk(clk),\n        .csb(sram_csb),\n        .we(sram_we),\n        .addr(sram_addr),\n        .din(sram_din),\n        .dout()\n    );\nendmodule"
