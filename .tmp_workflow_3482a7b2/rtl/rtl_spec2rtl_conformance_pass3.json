      "rtl_text": "module pwm_controller (\n    clk,\n    reset_n,\n    enable,\n    duty_cycle,\n    period,\n    pwm_out,\n    counter_value\n);\n    input clk;\n    input reset_n;\n    input enable;\n    input [7:0] duty_cycle;\n    input [7:0] period;\n    output pwm_out;\n    output [7:0] counter_value;\n    reg [7:0] counter_value_r;\n    assign counter_value = counter_value_r;\n    assign pwm_out = (counter_value_r < duty_cycle) ? 1'b1 : 1'b0;\n\n    always @(posedge clk or negedge reset_n) begin\n        if (!reset_n) begin\n            counter_value_r <= 8'h00;\n        end else if (enable) begin\n            if (counter_value_r >= period) begin\n                counter_value_r <= 8'h00;\n            end else begin\n                counter_value_r <= counter_value_r + 8'h01;\n            end\n        end\n    end\nendmodule"
    }
