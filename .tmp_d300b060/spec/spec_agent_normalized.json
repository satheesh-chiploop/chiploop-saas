  "hierarchy": {
    "top_module": {
      "name": "adaptive_aero_control_top",
      "description": "Top-level FPGA IP shell for active-aerodynamics control. It exposes a compact host MMIO register interface and compact command/response streaming interfaces, validates incoming commands, enforces sequence, freshness, timeout, range, and slew constraints, latches sticky faults, and drives a bounded actuator command output. On invalid, stale, timeout, or reset conditions it inhibits actuator command validity rather than substituting a fallback command.",
