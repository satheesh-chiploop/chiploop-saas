            "direction": "input",
            "width": 1
          },
          {
            "name": "hist_addr",
            "direction": "input",
            "width": 4
          },
          {
            "name": "hist_din",
            "direction": "input",
            "width": 32
          },
          {
            "name": "hist_dout",
            "direction": "output",
            "width": 32
          },
          {
            "name": "hist_csb",
            "direction": "output",
            "width": 1
          },
          {
            "name": "hist_we_n",
            "direction": "output",
            "width": 1
          }
        ],
        "functionality": "Provides a small BRAM-backed history interface for storing compact event records such as accepted command sequence, command value, and timestamp metadata. Intended only for bounded history/debug/trace; it is not a large FIFO or payload store.",
        "responsibilities": [
          "Offer bounded storage for compact accepted-command history.",
          "Remain FPGA-friendly and technology-neutral for native block RAM mapping.",
          "Avoid flattening storage into registers.",
          "Expose simple memory-like ports for write and read access."
        ],
        "must_drive": [
          "hist_csb",
          "hist_we_n",
          "hist_dout"
        ],
        "must_receive": [
          "clk",
          "rst_n",
          "hist_we",
          "hist_addr",
          "hist_din"
        ],
        "must_not_drive": [
          "hist_we",
          "hist_addr",
          "hist_din"
        ],
        "reset_behavior": "On reset, the memory interface is idle and no write is issued. Contents are not relied upon until explicitly written by logic after reset.",
        "behavior_rules": [
          "Storage depth is small and bounded.",
          "No large bulk payloads are accepted.",
          "The controller may be omitted from top-level connectivity if history is unused, but if instantiated it must follow the memory macro contract.",
          "No Sky130 SRAM macro is instantiated in the FPGA path."
        ],
        "rtl_output_file": "adaptive_aero_history_bram_ctrl.v"
