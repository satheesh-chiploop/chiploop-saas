      {
        "name": "adaptive_aero_history_bram_ctrl",
        "description": "Small technology-neutral history buffer controller for optional bounded history of accepted commands and timestamps. It is intended for FPGA block RAM mapping and never flattens into a bulk register array. The stored history supports software and safety tracing without exposing large payload arrays.",
        "ports": [
          {
            "name": "clk",
            "direction": "input",
            "width": 1
