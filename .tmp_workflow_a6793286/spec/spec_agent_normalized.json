{
  "name": "adaptive_aero_control_top",
  "description": "Top-level integration wrapper exposing Wishbone CSR/MMIO for firmware, bounded streaming model-request/model-response channels, and safe actuator command generation. It supervises enable, configuration validity, stale-data rejection, timeout handling, fault latching, clamping, and fallback behavior. The top module is the authoritative synthesizable entry point and must not be replaced by a status-only, telemetry-only, or leaf module.",
  "operating_constraints": {},
  "implementation_requirements": [],
  "verification_requirements": [],
  "memory_macros": [],
  "ports": [
    {
      "name": "clk",
      "direction": "input",
      "width": 1
    },
    {
      "name": "reset_n",
      "direction": "input",
      "width": 1,
      "active_low": true
    },
    {
      "name": "wb_adr_i",
      "direction": "input",
      "width": 32
    },
    {
      "name": "wb_dat_i",
      "direction": "input",
      "width": 32
    },
    {
      "name": "wb_dat_o",
      "direction": "output",
      "width": 32
    },
    {
      "name": "wb_sel_i",
      "direction": "input",
      "width": 4
    },
    {
      "name": "wb_cyc_i",
      "direction": "input",
      "width": 1
    },
    {
      "name": "wb_stb_i",
      "direction": "input",
      "width": 1
    },
    {
      "name": "wb_we_i",
      "direction": "input",
      "width": 1
    },
    {
      "name": "wb_ack_o",
      "direction": "output",
      "width": 1
    },
    {
      "name": "wb_err_o",
      "direction": "output",
      "width": 1
    },
    {
      "name": "wb_stall_o",
      "direction": "output",
      "width": 1
    },
    {
      "name": "model_req_data_o",
      "direction": "output",
      "width": 128
    },
    {
      "name": "model_req_valid_o",
      "direction": "output",
      "width": 1
    },
    {
      "name": "model_req_ready_i",
      "direction": "input",
      "width": 1
    },
    {
      "name": "model_rsp_data_i",
      "direction": "input",
      "width": 128
    },
    {
      "name": "model_rsp_valid_i",
      "direction": "input",
      "width": 1
    },
    {
      "name": "model_rsp_ready_o",
      "direction": "output",
      "width": 1
    },
    {
      "name": "actuator_cmd_o",
      "direction": "output",
      "width": 64
    },
    {
      "name": "actuator_valid_o",
      "direction": "output",
      "width": 1
    },
    {
      "name": "irq_fault_o",
      "direction": "output",
      "width": 1
    },
    {
      "name": "irq_update_o",
      "direction": "output",
      "width": 1
    },
    {
      "name": "irq_timeout_o",
      "direction": "output",
      "width": 1
    }
  ],
  "functionality": "Implements the complete firmware-visible control plane and external model transport contract for adaptive active-aero control. It decodes Wishbone CSR/MMIO transactions into configuration, status, and command registers; emits bounded model requests containing sequence, age/timestamp, speed bin/value, actuator context, and command mode flags; accepts bounded model responses and validates freshness, sequence, and format; clamps actuator commands to programmable min/max bounds; raises sticky faults and interrupts on malformed payloads, stale responses, timeout, watchdog, and invalid configuration; and forces safe fallback when enable is deasserted, configuration is invalid, or any fault is latched. The top-level output ports are driven only by real RTL logic and never by a child input alone.",
  "responsibilities": [
    "Expose a real firmware-visible CSR/MMIO interface with address, write-data, read-data, write-enable, transaction-valid, and response/ready semantics using the Wishbone bus provided at top level.",
    "Implement the required register contract and make every declared register reachable through RTL decode.",
    "Generate bounded model-request words and assert model_req_valid_o only when a complete request is available.",
    "Accept model-response words only when model_rsp_valid_i and model_rsp_ready_o handshake correctly.",
    "Provide safe actuator output behavior with clamping and fallback.",
    "Expose sticky fault bits, status, and interrupt outputs for fault, update, and timeout events.",
    "Honor backpressure on all valid/ready interfaces.",
    "Maintain deterministic bounded behavior at 50 MHz."
  ],
  "must_drive": [
    "wb_dat_o",
    "wb_ack_o",
    "wb_err_o",
    "wb_stall_o",
    "model_req_data_o",
    "model_req_valid_o",
    "model_rsp_ready_o",
    "actuator_cmd_o",
    "actuator_valid_o",
    "irq_fault_o",
    "irq_update_o",
    "irq_timeout_o"
  ],
  "must_receive": [
    "clk",
    "reset_n",
    "wb_adr_i",
    "wb_dat_i",
    "wb_sel_i",
    "wb_cyc_i",
    "wb_stb_i",
    "wb_we_i",
    "model_req_ready_i",
    "model_rsp_data_i",
    "model_rsp_valid_i"
  ],
  "must_not_drive": [
    "model_req_ready_i",
    "model_rsp_data_i",
    "model_rsp_valid_i"
  ],
  "reset_behavior": "On reset, disable closed-loop operation, clear or hold faults according to safe policy, drive actuator output to the safe fallback value, deassert actuator_valid_o, deassert model_req_valid_o, and hold model_rsp_ready_o in the implementation-defined safe receive state until firmware enables operation and configuration is valid.",
  "behavior_rules": [
    "A write to control.enable may arm closed-loop operation only if fault_latch is clear and configuration is valid.",
    "A write to fault-clear clears latched faults only when the safety supervisor indicates an idle or safe state and firmware acknowledges the event.",
    "Request packing must include a monotonically increasing sequence number, age/timestamp, speed bin/value, actuator context, and command mode flags within 128 bits or less.",
    "The request packager shall hold request contents stable when model_req_ready_i is low.",
    "The response checker shall validate sequence number, freshness against timeout_threshold, and basic format correctness before any actuator update.",
    "Any stale, malformed, or mismatched response shall set a sticky fault and inhibit actuator update.",
    "If the outstanding request times out, the safety supervisor shall latch timeout fault and command fallback without software intervention.",
    "All actuator outputs shall be clamped to programmable actuator_min and actuator_max before being asserted valid.",
    "If enable is deasserted or a fault is latched, output safe_fallback_value and/or inhibit act_valid according to the safe integration policy.",
    "The design shall not infer or compute the aerodynamic prediction itself."
  ],
  "rtl_output_file": "adaptive_aero_control_top.v",
  "register_contract": {
    "bus_type": "wishbone",
    "registers": [
      {
        "name": "control",
        "address": 0,
        "access": "rw",
        "width": 32,
        "fields": [
          {
            "name": "enable",
            "lsb": 0,
            "msb": 0,
            "access": "rw",
            "reset": 0,
            "description": "Arm closed-loop operation when configuration is valid and no fault is latched."
          },
          {
            "name": "fault_clear",
            "lsb": 1,
            "msb": 1,
            "access": "w1c",
            "reset": 0,
            "description": "Firmware acknowledgement to clear sticky faults when safe to do so."
          },
          {
            "name": "manual_fallback",
            "lsb": 2,
            "msb": 2,
            "access": "rw",
            "reset": 0,
            "description": "Force safe fallback command selection."
          },
          {
            "name": "irq_enable_fault",
            "lsb": 8,
            "msb": 8,
            "access": "rw",
            "reset": 1,
            "description": "Enable fault interrupt."
          },
          {
            "name": "irq_enable_update",
            "lsb": 9,
            "msb": 9,
            "access": "rw",
            "reset": 1,
            "description": "Enable update interrupt."
          },
          {
            "name": "irq_enable_timeout",
            "lsb": 10,
            "msb": 10,
            "access": "rw",
            "reset": 1,
            "description": "Enable timeout interrupt."
          }
        ]
      },
      {
        "name": "status",
        "address": 1,
        "access": "ro",
        "width": 32,
        "fields": [
          {
            "name": "enabled",
            "lsb": 0,
            "msb": 0,
            "access": "ro",
            "reset": 0,
            "description": "Current closed-loop enable state."
          },
          {
            "name": "config_valid",
            "lsb": 1,
            "msb": 1,
            "access": "ro",
            "reset": 0,
            "description": "Configuration validity summary."
          },
          {
            "name": "fault_latched",
            "lsb": 2,
            "msb": 2,
            "access": "ro",
            "reset": 0,
            "description": "Sticky fault indicator."
          },
          {
            "name": "timeout_active",
            "lsb": 3,
            "msb": 3,
            "access": "ro",
            "reset": 0,
            "description": "Outstanding request has timed out."
          },
          {
            "name": "request_pending",
            "lsb": 4,
            "msb": 4,
            "access": "ro",
            "reset": 0,
            "description": "A model request is pending response."
          },
          {
            "name": "response_valid",
            "lsb": 5,
            "msb": 5,
            "access": "ro",
            "reset": 0,
            "description": "A valid response was accepted."
          },
          {
            "name": "stale_fault",
            "lsb": 6,
            "msb": 6,
            "access": "ro",
            "reset": 0,
            "description": "Stale or mismatched response detected."
          },
          {
            "name": "watchdog_fault",
            "lsb": 7,
            "msb": 7,
            "access": "ro",
            "reset": 0,
            "description": "Watchdog or supervision fault detected."
          },
          {
            "name": "last_valid_sequence",
            "lsb": 16,
            "msb": 31,
            "access": "ro",
            "reset": 0,
            "description": "Snapshot of most recent accepted sequence number."
          }
        ]
      },
      {
        "name": "timeout_threshold",
        "address": 2,
        "access": "rw",
        "width": 32,
        "fields": [
          {
            "name": "cycles",
            "lsb": 0,
            "msb": 31,
            "access": "rw",
            "reset": 1000,
            "description": "Maximum age in clock cycles before request timeout."
          }
        ]
      },
      {
        "name": "stale_sequence_limit",
        "address": 3,
        "access": "rw",
        "width": 32,
        "fields": [
          {
            "name": "max_delta",
            "lsb": 0,
            "msb": 31,
            "access": "rw",
            "reset": 1,
            "description": "Maximum acceptable sequence delta or mismatch tolerance, typically one outstanding transaction only."
          }
        ]
      },
      {
        "name": "actuator_min",
        "address": 4,
        "access": "rw",
        "width": 32,
        "fields": [
          {
            "name": "limit",
            "lsb": 0,
            "msb": 31,
            "access": "rw",
            "reset": 0,
            "description": "Minimum allowed actuator command value."
          }
        ]
      },
      {
        "name": "actuator_max",
        "address": 5,
        "access": "rw",
        "width": 32,
        "fields": [
          {
            "name": "limit",
            "lsb": 0,
            "msb": 31,
            "access": "rw",
            "reset": 65535,
            "description": "Maximum allowed actuator command value."
          }
        ]
      },
      {
        "name": "safe_fallback_value",
        "address": 6,
        "access": "rw",
        "width": 32,
        "fields": [
          {
            "name": "value",
            "lsb": 0,
            "msb": 31,
            "access": "rw",
            "reset": 0,
            "description": "Fallback actuator value used on reset, disable, or fault."
          }
        ]
      },
      {
        "name": "current_sequence",
        "address": 7,
        "access": "ro",
        "width": 32,
        "fields": [
          {
            "name": "sequence",
            "lsb": 0,
            "msb": 31,
            "access": "ro",
            "reset": 0,
            "description": "Current outstanding or next sequence number."
          }
        ]
      },
      {
        "name": "last_valid_age",
        "address": 8,
        "access": "ro",
        "width": 32,
        "fields": [
          {
            "name": "age_cycles",
            "lsb": 0,
            "msb": 31,
            "access": "ro",
            "reset": 0,
            "description": "Age in cycles of the last accepted response."
          }
        ]
      },
      {
        "name": "fault_latch",
        "address": 9,
        "access": "ro",
        "width": 32,
        "fields": [
          {
            "name": "latched",
            "lsb": 0,
            "msb": 0,
            "access": "ro",
            "reset": 0,
            "description": "Sticky fault summary bit."
          },
          {
            "name": "timeout_fault",
            "lsb": 1,
            "msb": 1,
            "access": "ro",
            "reset": 0,
            "description": "Timeout fault sticky bit."
          },
          {
            "name": "stale_fault",
            "lsb": 2,
            "msb": 2,
            "access": "ro",
            "reset": 0,
            "description": "Stale-response fault sticky bit."
          },
          {
            "name": "format_fault",
            "lsb": 3,
            "msb": 3,
            "access": "ro",
            "reset": 0,
            "description": "Malformed payload fault sticky bit."
          },
          {
            "name": "config_fault",
            "lsb": 4,
            "msb": 4,
            "access": "ro",
            "reset": 0,
            "description": "Invalid configuration sticky bit."
          },
          {
            "name": "watchdog_fault",
            "lsb": 5,
            "msb": 5,
            "access": "ro",
            "reset": 0,
            "description": "Watchdog sticky bit."
          }
        ]
      },
      {
        "name": "enable",
        "address": 10,
        "access": "rw",
        "width": 32,
        "fields": [
          {
            "name": "enable",
            "lsb": 0,
            "msb": 0,
            "access": "rw",
            "reset": 0,
            "description": "Dedicated enable mirror for firmware visibility and decode simplicity."
          }
        ]
      },
      {
        "name": "request_word_low",
        "address": 11,
        "access": "ro",
        "width": 32,
        "fields": [
          {
            "name": "request_low",
            "lsb": 0,
            "msb": 31,
            "access": "ro",
            "reset": 0,
            "description": "Low 32 bits of the most recently packed model request."
          }
        ]
      },
      {
        "name": "request_word_high",
        "address": 12,
        "access": "ro",
        "width": 32,
        "fields": [
          {
            "name": "request_high",
            "lsb": 0,
            "msb": 31,
            "access": "ro",
            "reset": 0,
            "description": "High 32 bits of the most recently packed model request."
          }
        ]
      },
      {
        "name": "response_word_low",
        "address": 13,
        "access": "ro",
        "width": 32,
        "fields": [
          {
            "name": "response_low",
            "lsb": 0,
            "msb": 31,
            "access": "ro",
            "reset": 0,
            "description": "Low 32 bits of the most recently accepted model response."
          }
        ]
      },
      {
        "name": "response_word_high",
        "address": 14,
        "access": "ro",
        "width": 32,
        "fields": [
          {
            "name": "response_high",
            "lsb": 0,
            "msb": 31,
            "access": "ro",
            "reset": 0,
            "description": "High 32 bits of the most recently accepted model response."
          }
        ]
      },
      {
        "name": "actuator_command",
        "address": 15,
        "access": "ro",
        "width": 32,
        "fields": [
          {
            "name": "command",
            "lsb": 0,
            "msb": 31,
            "access": "ro",
            "reset": 0,
            "description": "Current clamped actuator command visible to firmware."
          }
        ]
      },
      {
        "name": "telemetry_counters",
        "address": 16,
        "access": "ro",
        "width": 32,
        "fields": [
          {
            "name": "requests_accepted",
            "lsb": 0,
            "msb": 7,
            "access": "ro",
            "reset": 0,
            "description": "Accepted request counter."
          },
          {
            "name": "responses_accepted",
            "lsb": 8,
            "msb": 15,
            "access": "ro",
            "reset": 0,
            "description": "Accepted response counter."
          },
          {
            "name": "timeouts",
            "lsb": 16,
            "msb": 23,
            "access": "ro",
            "reset": 0,
            "description": "Timeout counter."
          },
          {
            "name": "stale_rejects",
            "lsb": 24,
            "msb": 31,
            "access": "ro",
            "reset": 0,
            "description": "Stale-response rejection counter."
          }
        ]
      }
    ]
  }
}