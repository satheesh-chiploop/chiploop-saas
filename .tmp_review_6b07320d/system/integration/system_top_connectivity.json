{
  "top": {
    "base_name": "temp_monitor_soc",
    "sim_module": "temp_monitor_soc_sim",
    "phys_module": "temp_monitor_soc_phys",
    "functionality": "Integrates a digital temperature monitor controller with a temperature sensor ADC behavioral model so software-visible register activity can request samples, receive ADC results, and generate a temperature alert based on the monitored code and threshold.",
    "responsibilities": [
      "Instantiate the digital monitor and analog sensor ADC model.",
      "Provide the digital register interface at the SoC top with the same widths as the digital controller.",
      "Route sample request and ADC result handshake signals between the two blocks.",
      "Expose alert and decoded temperature/threshold observables for simulation visibility.",
      "Keep the analog supply ports and sensor temperature input available at the top level for behavioral simulation and downstream handoff."
    ],
    "must_drive": [
      "clk",
      "reset_n",
      "wr_en",
      "wr_addr[7:0]",
      "wr_data[15:0]",
      "rd_en",
      "rd_addr[7:0]",
      "sensor_temp_celsius[15:0]",
      "avdd",
      "avss"
    ],
    "must_receive": [
      "rd_data[15:0]",
      "alert_irq",
      "temp_code[11:0]",
      "threshold_code[11:0]",
      "alert_status"
    ],
    "must_not_drive": [
      "adc_code[11:0]",
      "adc_valid",
      "sample_req"
    ],
    "reset_behavior": "During reset, the integrated system must hold the digital monitor in its reset state, deassert sample activity, and prevent alert generation until reset is released and valid conversion activity resumes.",
    "behavior_rules": [
      "The digital controller is the sole owner of the memory-mapped register interface behavior.",
      "The analog model only responds to sample requests and sensor conditions; it must not be driven directly by top-level control except through its defined inputs.",
      "ADC result signals must flow from the analog model into the digital monitor only.",
      "Alert state and decoded temperature observables must reflect the digital monitor outputs without additional top-level transformation.",
      "The analog behavioral model must remain available in simulation and a physical/abstract placeholder must be provided for downstream handoff."
    ]
  },
